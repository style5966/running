<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Sub-3 Hybrid Program v5.6 (Trendy Design)</title>
  <style>
    :root {
      --bg-dark: #09090b;
      --bg-card: rgba(24, 24, 27, 0.6);
      --border: rgba(255, 255, 255, 0.08);
      --primary: #38bdf8; /* Sky Blue */
      --accent: #a78bfa; /* Soft Purple */
      --success: #34d399; /* Mint */
      --warning: #fbbf24; /* Amber */
      --danger: #f87171; /* Red */
      --text-main: #f4f4f5;
      --text-muted: #a1a1aa;
      --gradient-text: linear-gradient(135deg, #38bdf8, #818cf8);
      --gradient-bg: radial-gradient(circle at 50% -20%, #1e1b4b, #09090b);
      --glass: blur(12px) saturate(180%);
      --radius: 20px;
    }

    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Pretendard", "Segoe UI", Roboto, sans-serif;
      background: var(--gradient-bg);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      padding-bottom: 40px;
    }

    .container {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }

    /* Typography */
    h1 {
      font-size: 28px;
      margin: 0 0 8px 0;
      background: var(--gradient-text);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      letter-spacing: -0.5px;
    }
    h2 { font-size: 18px; margin: 0 0 12px 0; font-weight: 600; letter-spacing: -0.3px; color: var(--text-main); }
    h3 { font-size: 16px; margin: 0; font-weight: 600; }
    p { margin: 0; color: var(--text-muted); font-size: 14px; line-height: 1.5; }

    /* Components */
    .card {
      background: var(--bg-card);
      backdrop-filter: var(--glass);
      -webkit-backdrop-filter: var(--glass);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
      margin-bottom: 16px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .between { justify-content: space-between; }

    /* Chips */
    .chip-group { display: flex; gap: 8px; background: rgba(0,0,0,0.2); padding: 4px; border-radius: 99px; display: inline-flex; }
    .chip {
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 6px 14px;
      border-radius: 99px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .chip[aria-pressed="true"] {
      background: rgba(255,255,255,0.1);
      color: var(--text-main);
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    /* Inputs */
    .grid-inputs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
    @media(min-width: 600px) { .grid-inputs { grid-template-columns: repeat(4, 1fr); } }

    .field { display: flex; flex-direction: column; gap: 6px; }
    .field label { font-size: 12px; color: var(--text-muted); font-weight: 500; margin-left: 4px; }
    .input, .select {
      background: rgba(0, 0, 0, 0.3);
      border: 1px solid var(--border);
      color: var(--text-main);
      padding: 12px 14px;
      border-radius: 12px;
      font-size: 15px;
      width: 100%;
      transition: border-color 0.2s;
    }
    .input:focus, .select:focus { outline: none; border-color: var(--primary); background: rgba(0,0,0,0.5); }

    /* KPI Grid */
    .kpi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 10px; }
    .kpi-box {
      background: rgba(255,255,255,0.03);
      border-radius: 16px;
      padding: 14px;
      text-align: center;
      border: 1px solid var(--border);
    }
    .kpi-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
    .kpi-value { font-size: 15px; font-weight: 700; color: var(--primary); }
    .kpi-box.main .kpi-value { color: var(--success); font-size: 17px; }

    /* Slider styling */
    input[type=range] {
      -webkit-appearance: none; width: 100%; background: transparent; margin: 10px 0;
    }
    input[type=range]::-webkit-slider-runnable-track {
      width: 100%; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; cursor: pointer;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none; height: 24px; width: 24px; border-radius: 50%;
      background: var(--text-main); margin-top: -9px; cursor: pointer;
      box-shadow: 0 0 15px rgba(255,255,255,0.5); border: 2px solid #000;
    }

    /* Week List */
    ul.timeline { margin: 0; padding: 0; list-style: none; margin-top: 16px; }
    li.day-row {
      display: flex;
      align-items: center;
      padding: 14px;
      margin-bottom: 8px;
      background: rgba(255,255,255,0.03);
      border-radius: 12px;
      border-left: 3px solid transparent;
      transition: transform 0.2s;
    }
    li.day-row:active { transform: scale(0.98); }
    
    li.type-easy { border-left-color: var(--success); }
    li.type-long { border-left-color: var(--warning); background: linear-gradient(90deg, rgba(251, 191, 36, 0.05), transparent); }
    li.type-race { border-left-color: var(--danger); background: linear-gradient(90deg, rgba(248, 113, 113, 0.1), transparent); }
    li.type-rest { opacity: 0.5; border-left-color: var(--text-muted); }

    .day-content { flex: 1; margin-left: 10px; font-size: 14px; }
    .badge {
      font-size: 10px; font-weight: 700; padding: 4px 8px; border-radius: 6px;
      text-transform: uppercase; letter-spacing: 0.5px;
    }
    .badge.success { background: rgba(52, 211, 153, 0.15); color: var(--success); }
    .badge.warning { background: rgba(251, 191, 36, 0.15); color: var(--warning); }
    .badge.danger { background: rgba(248, 113, 113, 0.15); color: var(--danger); }
    .badge.accent { background: rgba(167, 139, 250, 0.15); color: var(--accent); }

    /* Floating Action Button */
    .fab {
      position: fixed; bottom: 24px; right: 24px;
      background: var(--text-main); color: #000;
      padding: 12px 20px; border-radius: 99px;
      font-weight: 600; box-shadow: 0 4px 20px rgba(255,255,255,0.2);
      font-size: 14px; cursor: pointer; border: none;
      z-index: 100;
    }

    /* Utilities */
    .text-accent { color: var(--accent); }
    .text-warn { color: var(--warning); }
    .hidden { display: none; }
    
    /* Animation */
    @keyframes slideIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .animate-in { animation: slideIn 0.3s ease-out forwards; }

  </style>
</head>
<body>

  <div class="container">
    <!-- Header -->
    <header style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: flex-end;">
      <div>
        <div class="chip-group" style="margin-bottom: 8px;">
          <span class="chip" style="color:var(--accent); font-weight:700; cursor:default;">Hybrid v5.6</span>
          <span class="chip" style="cursor:default;">Elite Km</span>
        </div>
        <h1>Sub-3 Hybrid</h1>
        <p>크로스핏 + 러닝: 엘리트 거리 기반 훈련</p>
      </div>
    </header>

    <!-- Profile Card -->
    <section class="card">
      <div class="row between" style="margin-bottom: 16px;">
        <h2>My Profile</h2>
        <div class="chip-group">
          <button class="chip" data-units="metric" aria-pressed="true">km</button>
          <button class="chip" data-units="imperial" aria-pressed="false">mi</button>
        </div>
      </div>
      
      <div class="grid-inputs">
        <div class="field">
          <label>체중 (kg)</label>
          <input id="in-weight" class="input" type="number" value="70" />
        </div>
        <div class="field">
          <label>10K 기록 (분:초)</label>
          <input id="in-10k" class="input" placeholder="45:00" />
        </div>
        <div class="field">
          <label>풀코스 (시:분:초)</label>
          <input id="in-m" class="input" placeholder="3:30:00" />
        </div>
        <div class="field">
          <label>성별</label>
          <select id="in-sex" class="select">
            <option value="male">남성</option>
            <option value="female">여성</option>
          </select>
        </div>
      </div>

      <!-- Pace KPI -->
      <div class="kpi-grid">
        <div class="kpi-box main">
          <div class="kpi-label">Zone 2 (Easy)</div>
          <div id="kpi-easy" class="kpi-value">—</div>
        </div>
        <div class="kpi-box">
          <div class="kpi-label">Marathon Pace</div>
          <div id="kpi-mp" class="kpi-value">—</div>
        </div>
        <div class="kpi-box">
          <div class="kpi-label">10K Pace</div>
          <div id="kpi-10k" class="kpi-value">—</div>
        </div>
      </div>
      <p style="margin-top: 12px; font-size: 12px; text-align: center; color: var(--warning); opacity: 0.8;">
        ⚠️ 모든 Easy/LSD 훈련은 위 <strong>Zone 2</strong> 페이스보다 빨라지면 안 됩니다.
      </p>
    </section>

    <!-- Weekly Schedule -->
    <section class="card" id="panel-weekly">
      <div class="row between">
        <h2 id="week-title" class="text-accent">Week 1</h2>
        <span id="week-badge" class="badge accent">BASE</span>
      </div>
      
      <p id="week-desc" style="margin-bottom: 16px;">훈련 설명 로딩중...</p>

      <!-- Slider Component -->
      <div style="padding: 0 8px; margin-bottom: 20px;">
        <input type="range" id="week-slider" min="1" max="16" value="1" step="1">
        <div class="row between" style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">
          <span>Start</span>
          <span>4w(5K)</span>
          <span>8w(10K)</span>
          <span>12w(HM)</span>
          <span>Race</span>
        </div>
      </div>

      <!-- Schedule List -->
      <ul class="timeline" id="week-list">
        <!-- JS Generated Items -->
      </ul>
    </section>

    <!-- Info Card -->
    <section class="card" style="border-color: rgba(56, 189, 248, 0.2);">
      <h3>💡 Hybrid Guide</h3>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px;">
        <div>
          <p style="color: var(--success); font-weight: 600; font-size: 13px; margin-bottom: 4px;">Pure Easy Run</p>
          <p style="font-size: 12px; opacity: 0.8;">Brick(근전환) 강박 없이, 본인이 가장 편안한 시간에 러닝을 배치하세요. 핵심은 '낮은 심박수' 유지입니다.</p>
        </div>
        <div>
          <p style="color: var(--warning); font-weight: 600; font-size: 13px; margin-bottom: 4px;">Distance Trap</p>
          <p style="font-size: 12px; opacity: 0.8;">"30km 채우기"에 급급해 빨라지면 안 됩니다. <strong>"30km를 Zone 2로 느긋하게"</strong>가 정답입니다.</p>
        </div>
      </div>
    </section>

  </div>

  <button class="fab" onclick="window.scrollTo({top:0, behavior:'smooth'})">TOP</button>

  <script>
  (function(){
    'use strict';
    
    const state = { rec10k:'', recM:'', curWeek: 1 };
    const setById=(id,txt)=>{ const el=document.getElementById(id); if(el) el.textContent=txt; };
    const pad2=n=>String(n).padStart(2,'0');

    function parseTimeToSec(v){
      if(!v) return 0;
      const s=String(v).trim();
      const p=s.split(':').map(x=>parseInt(x,10));
      if(p.length===2) return p[0]*60 + p[1];
      if(p.length===3) return p[0]*3600 + p[1]*60 + p[2];
      return 0;
    }
    function paceStr(secPerKm){
      if(!secPerKm) return '—';
      const m = Math.floor(secPerKm/60);
      const s = Math.round(secPerKm%60);
      return `${m}'${pad2(s)}"`;
    }
    
    function calculatePaces(){
      const t10 = parseTimeToSec(state.rec10k);
      const tM = parseTimeToSec(state.recM);
      let mp = 0;
      if(tM) mp = tM/42.195;
      else if(t10) mp = (t10 * 4.65) / 42.195; 
      
      const z2_fast = mp ? mp + 45 : 0;
      const z2_slow = mp ? mp + 90 : 0;
      const k10 = t10 ? t10/10 : (mp ? mp - 15 : 0);

      setById('kpi-mp', paceStr(mp));
      setById('kpi-easy', z2_fast ? `${paceStr(z2_fast)} ~ ${paceStr(z2_slow)}` : '—');
      setById('kpi-10k', paceStr(k10));
    }

    function getWeekData(w) {
        let title, badge, desc, schedule;
        
        if (w === 4) { 
            title = `Week ${w}: 5K Check`;
            badge = "TEST WEEK";
            desc = "현재 스피드 감각을 점검합니다. 5km를 전력으로 달려 기록을 측정하세요.";
            schedule = [
                {t:"월: Easy Run 5 km (가볍게)", type:"easy"},
                {t:"화: 휴식 (크로스핏)", type:"rest"},
                {t:"수: Easy Run 6 km + 질주 4회", type:"easy"},
                {t:"목: 완전 휴식", type:"rest"},
                {t:"금: [TEST] 웜업 2km + 5K TT + 쿨다운 2km", type:"race"},
                {t:"토: 회복 조깅 7 km (아주 천천히)", type:"easy"},
                {t:"일: 휴식", type:"rest"}
            ];
        } else if (w === 8) { 
            title = `Week ${w}: 10K Check`;
            badge = "TEST WEEK";
            desc = "유산소 역치 능력을 점검합니다. 10km를 일정한 페이스로 강하게 밉니다.";
            schedule = [
                {t:"월: Easy Run 6 km", type:"easy"},
                {t:"화: 휴식", type:"rest"},
                {t:"수: Easy Run 5 km + 질주 4회", type:"easy"},
                {t:"목: 완전 휴식", type:"rest"},
                {t:"금: [TEST] 웜업 2km + 10K TT + 쿨다운 2km", type:"race"},
                {t:"토: 회복 조깅 8 km", type:"easy"},
                {t:"일: 휴식", type:"rest"}
            ];
        } else if (w === 12) {
            title = `Week ${w}: HM Check`;
            badge = "TEST WEEK";
            desc = "장거리 지구력과 레이스 운영 능력(급수, 젤)을 리허설합니다.";
            schedule = [
                {t:"월: Easy Run 6 km", type:"easy"},
                {t:"화: 휴식", type:"rest"},
                {t:"수: Easy 8 km (가볍게)", type:"easy"},
                {t:"목: 완전 휴식", type:"rest"},
                {t:"금: 휴식 or 3km 쉐이크아웃", type:"easy"},
                {t:"토: [TEST] 하프마라톤 TT (대회 페이스 +5~10초)", type:"race"},
                {t:"일: 휴식", type:"rest"}
            ];
        } else if (w >= 16) { 
            title = `Week ${w}: D-DAY`;
            badge = "RACE WEEK";
            desc = "테이퍼링 완료. 최상의 컨디션으로 출발선에 서세요.";
            schedule = [
                {t:"월: Easy Run 5 km", type:"easy"},
                {t:"화: 휴식", type:"rest"},
                {t:"수: Easy 4 km + 질주 2회", type:"easy"},
                {t:"목: 완전 휴식", type:"rest"},
                {t:"금: 완전 휴식", type:"rest"},
                {t:"토: [D-DAY] 42.195km RACE", type:"race"},
                {t:"일: 회복", type:"rest"}
            ];
        } else {
            let easyDist, lsdDist;
            let phaseName = "";
            
            if(w < 4) { 
                phaseName = "적응기"; 
                easyDist = 5 + (w-1); 
                lsdDist = 10 + (w-1)*2; 
            } else if (w < 8) {
                phaseName = "빌드업 I";
                easyDist = 7 + (w-5)*0.5; 
                lsdDist = 16 + (w-5)*2; 
            } else if (w < 12) {
                phaseName = "빌드업 II";
                easyDist = 8 + (w-9)*0.5; 
                lsdDist = 24 + (w-9)*2; 
            } else {
                phaseName = "완성기";
                easyDist = 8;
                if(w===13) lsdDist = 32; 
                else if(w===14) lsdDist = 24; 
                else if(w===15) lsdDist = 16; 
            }
            
            easyDist = Math.floor(easyDist);
            title = `Week ${w}: ${phaseName}`;
            badge = "TRAINING";
            desc = `LSD 목표: ${lsdDist}km (Zone 2). 주간 마일리지와 크로스핏 강도를 조절하세요.`;
            
            schedule = [
                {t:`월: Easy Run ${easyDist} km (유동적)`, type:"easy"},
                {t:`화: Easy Run ${easyDist+1} km`, type:"easy"},
                {t:`수: Easy Run ${easyDist} km`, type:"easy"},
                {t:`목: 완전 휴식`, type:"rest"},
                {t:`금: Easy ${easyDist-1} km + 질주 4회`, type:"easy"},
                {t:`토: LSD ${lsdDist} km (절대 Zone 2 준수)`, type:"long"},
                {t:`일: 완전 휴식`, type:"rest"}
            ];
        }
        return { title, badge, desc, schedule };
    }

    function renderSchedule(){
        const data = getWeekData(state.curWeek);
        setById('week-title', data.title);
        setById('week-badge', data.badge);
        setById('week-desc', data.desc);
        
        const badgeEl = document.getElementById('week-badge');
        badgeEl.className = 'badge';
        if(data.badge.includes("TEST") || data.badge.includes("RACE")) badgeEl.classList.add('danger');
        else badgeEl.classList.add('accent');

        const ul = document.getElementById('week-list');
        ul.innerHTML = '';
        
        data.schedule.forEach((item, idx) => {
            const li = document.createElement('li');
            li.className = `day-row type-${item.type} animate-in`;
            li.style.animationDelay = `${idx * 0.05}s`;
            
            let badgeHtml = '';
            if(item.type === 'race') badgeHtml = '<span class="badge danger">TARGET</span>';
            else if(item.type === 'long') badgeHtml = '<span class="badge warning">LSD</span>';
            else if(item.type === 'easy') badgeHtml = '<span class="badge success">EASY</span>';
            
            li.innerHTML = `
              <div class="day-content">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                  <span style="font-weight:600; color:var(--text-main);">${item.t.split(':')[0]}</span>
                  ${badgeHtml}
                </div>
                <div style="margin-top:4px; opacity:0.8;">${item.t.split(':')[1] || ''}</div>
              </div>
            `;
            ul.appendChild(li);
        });
    }

    const inputs = ['in-10k','in-m'];
    inputs.forEach(id => {
        const el = document.getElementById(id);
        el.addEventListener('input', () => {
            state.rec10k = document.getElementById('in-10k').value;
            state.recM = document.getElementById('in-m').value;
            calculatePaces();
        });
    });

    const slider = document.getElementById('week-slider');
    slider.addEventListener('input', (e) => {
        state.curWeek = parseInt(e.target.value);
        renderSchedule();
    });

    calculatePaces();
    renderSchedule();
  })();
  </script>
</body>
</html>
